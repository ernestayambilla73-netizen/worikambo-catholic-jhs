{
  "version": 2,
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node" },
    { "src": "Worikambo_RC_JHS_BLUE_WHITE_FULLSTACK/public/**", "use": "@vercel/static" }
  ],
  "routes": [
